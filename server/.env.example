# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=dev

# ── Database ───────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=iti-hub
DB_USER=
DB_PASSWORD=
# Alternatively set DB_URL directly (takes precedence over the parts above)
# DB_URL=mongodb://127.0.0.1:27017/iti-hub

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# ── Networking ─────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
API_URL=http://localhost:5000

# ── File storage (Cloudinary) ──────────────────────────────────────────────
# Optional: when these are unset, uploaded files (track files, group photos,
# message images) fall back to local-disk storage under server/uploads/ and
# are served from /uploads. Set them to use Cloudinary instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
